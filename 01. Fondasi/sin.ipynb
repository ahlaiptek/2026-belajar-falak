   "source": [
    "import math\n",
    "\n",
    "def mencari_sin(sudut: int, panjang_sisi: int) -> float:\n",
    "    sudut_rad = math.radians(sudut)\n",
    "    hasil_sin = panjang_sisi * math.sin(sudut_rad)\n",
    "    return hasil_sin\n",
    "\n",
    "print(\"Hasil sin dari sudut 30 derajat dengan panjang sisi 3000 adalah:\", mencari_sin(30, 3000))"
   ]
  }
 ],
